# 环境变量示例文件
# 复制此文件并重命名为 .env.local 以覆盖默认配置

# 应用名称
VITE_APP_NAME=Cnotely

# API基础URL
VITE_API_BASE_URL=http://localhost:8000/api

# GitHub OAuth Client ID（公开，可放前端）
VITE_GITHUB_CLIENT_ID=bd5ffb66c070824348bfdee8fb174ea5e99317bf

# Google OAuth Client ID（公开，可放前端）
VITE_GOOGLE_CLIENT_ID=你的GoogleClientID

# Turnstile Site Key（公开）
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── 以下仅开发环境（.env.development）需要 ──

# GitHub Client Secret（开发时 vite proxy 自动追加，不会进入前端代码）
# GITHUB_CLIENT_SECRET=你的GitHubAppClientSecret

# HTTP 代理（国内开发时连 GitHub 用）
# VITE_HTTP_PROXY=http://127.0.0.1:7890

# ── 以下仅生产环境（.env.production）需要 ──

# Cloudflare Worker URL（Worker 在服务端补 client_secret）
# VITE_GITHUB_TOKEN_PROXY_URL=https://your-worker.your-subdomain.workers.dev/api/github/token
